# Admin: only for pairing/device administration. Keep it off clients.
ZEUS_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Agent: used only by Codex/Claude/Antigravity/Generic adapters.
ZEUS_AGENT_TOKEN=replace-with-a-different-long-random-agent-token
ZEUS_LISTEN_ADDR=:8080
ZEUS_PROVIDERS_FILE=/app/providers.json
ZEUS_STATE_FILE=/data/auth.json
ZEUS_SESSION_STATE_FILE=/data/sessions.json
# Comma-separated browser/Tauri origins. Native mobile clients do not send Origin.
ZEUS_ALLOWED_ORIGINS=http://localhost:1420,https://tauri.localhost

# Configure only the provider credentials you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
